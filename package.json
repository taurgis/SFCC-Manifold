{
  "name": "sfcc-pipeline-visualiser",
  "displayName": "SFCC Pipeline Visualiser",
  "description": "Visualise Salesforce Commerce Cloud (Demandware) pipelines as interactive graphs in VS Code.",
  "version": "0.0.1",
  "publisher": "your-name",
  "engines": {
    "vscode": "^1.84.0"
  },
  "categories": [
    "Other"
  ],
  "main": "./dist/extension.js",
  "activationEvents": [
    "onLanguage:xml",
    "workspaceContains:**/pipelines/*.xml"
  ],
  "contributes": {
    "commands": [
      {
        "command": "sfccPipelineVisualizer.open",
        "title": "Open SFCC Pipeline Visualiser",
        "category": "SFCC Pipeline"
      },
      {
        "command": "sfccPipelineVisualizer.openSource",
        "title": "Open Pipeline Source XML",
        "category": "SFCC Pipeline",
        "icon": "$(code)"
      },
      {
        "command": "sfccPipelineVisualizer.openVisualizer",
        "title": "Open Pipeline Visualizer",
        "category": "SFCC Pipeline",
        "icon": "$(type-hierarchy)"
      }
    ],
    "customEditors": [
      {
        "viewType": "sfccPipelineVisualizer.pipelineEditor",
        "displayName": "SFCC Pipeline Visualizer",
        "selector": [
          {
            "filenamePattern": "**/pipelines/*.xml"
          },
          {
            "filenamePattern": "**/pipeline_examples/*.xml"
          }
        ],
        "priority": "default"
      }
    ],
    "menus": {
      "editor/title": [
        {
          "command": "sfccPipelineVisualizer.openSource",
          "when": "activeCustomEditorId == sfccPipelineVisualizer.pipelineEditor",
          "group": "navigation"
        },
        {
          "command": "sfccPipelineVisualizer.openVisualizer",
          "when": "resourceLangId == xml && resourceFilename =~ /\\.xml$/",
          "group": "navigation"
        }
      ]
    }
  },
  "scripts": {
    "compile": "tsc -p ./",
    "watch": "tsc -watch -p ./"
  },
  "devDependencies": {
    "@types/node": "^20.11.17",
    "@types/vscode": "^1.84.0",
    "typescript": "^5.3.3"
  },
  "dependencies": {
    "@xmldom/xmldom": "^0.8.10",
    "konva": "^9.3.22",
    "tslib": "^2.6.2"
  }
}
